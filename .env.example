# ─── Required ───────────────────────────────────────────────────────────────
# JWT secret — MUST match JWT_SECRET in veeragenai_projects_be (the auth backend)
JWT_SECRET=your-jwt-secret-here

# ─── Optional ───────────────────────────────────────────────────────────────
# Frontend URL(s) for CORS — comma-separated for multiple origins
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=

# Secure cookie (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Data directory for the SQLite database file (leave blank for local dev)
DATA_DIR=

PORT=8003
CLEANUP_INTERVAL_SECONDS=3600

# ─── Shared storage (get these from veeragenai_projects_be's .env) ───────────
# Same Hugging Face bucket veeragenai_projects_be uses (documents are stored
# under an "agent-orchestrator/" prefix so they don't collide with its own).
HUGGINGFACE_TOKEN=
HUGGINGFACE_BUCKET=veera20/veeragenaiproject
# Same Pinecone account/API key as veeragenai_projects_be, but a dedicated
# index — this project's OpenAI embeddings are 1536-dim, veeragenai's Gemini
# embeddings are 768-dim, so they cannot share an index.
PINECONE_API_KEY=
PINECONE_INDEX=agent-orchestrator-rag
